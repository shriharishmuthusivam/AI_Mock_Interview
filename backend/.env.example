# Copy this file to `.env` and fill in real values.
# Never commit the real `.env` file.

# Groq API key (https://console.groq.com)
GROQ_API_KEY=
GROQ_MODEL=llama-3.1-8b-instant

# Gemini API fallback (https://aistudio.google.com) - used automatically when
# Groq is rate-limited. Free tier: ~1,500 requests/day, 1M tokens/min.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.6-flash

# MongoDB Atlas connection string
MONGO_URI=

# Auth
JWT_SECRET=change-me-to-a-long-random-secret

# Frontend origin allowed by CORS (e.g. https://your-site.netlify.app)
CLIENT_URL=http://localhost:3000

# SMTP for PDF report emails (fill these in to enable emailing)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=
SMTP_PASS=
SMTP_FROM=
